# networking-fun lab manifest
#
# Copy this to .platform/manifest.yaml on your PR branch and edit. The
# lab-provision workflow validates it against .platform/manifest.schema.json
# (and the per-lab scenario whitelist in
# .github/scripts/validate-manifest.py) before any AWS call.
#
# Enums:
#   lab:
#     hello-fargate   # per-PR Fargate service on the shared lab cluster
#
#   scenario (each injects exactly one fault; see labs/modules/container-lab/README.md):
#     happy-path
#     sg-port-mismatch
#     broken-task-execution-role
#     bad-image-tag
#     failing-health-check
#     misconfigured-task-definition

lab: hello-fargate
scenario: happy-path
ttl: 2h
notes: "Smoke test for the container lab happy path"
