# networking-fun lab manifest
#
# Copy this to .platform/manifest.yaml on your PR branch and edit. The
# lab-provision workflow validates it against .platform/manifest.schema.json
# before any AWS call.
#
# Enums:
#   lab:      layered-reachability (slice 11 adds three-tier-segmentation)
#   scenario: happy-path | nacl-deny-egress | missing-vpc-endpoint | dns-disabled
#
# Each fault scenario breaks one layer; the probe matrix reports
# expected-vs-actual so a "failed" probe is the success criterion. See
# labs/README.md for the per-scenario lesson.

lab: layered-reachability
scenario: happy-path
ttl: 2h
notes: "Smoke test for Lab #1 happy path"
