{
  "tags": {
    "Project": {
      "tag_key": {
        "@@assign": "Project"
      },
      "tag_value": {
        "@@assign": ["networking-fun"]
      },
      "enforced_for": {
        "@@assign": [
          "ec2:instance",
          "ec2:volume",
          "ec2:vpc",
          "ec2:subnet",
          "ec2:security-group",
          "ec2:network-acl",
          "ec2:route-table",
          "ec2:internet-gateway",
          "ec2:natgateway",
          "ec2:transit-gateway",
          "ec2:transit-gateway-attachment",
          "ec2:vpc-endpoint",
          "ec2:elastic-ip",
          "ec2:network-interface",
          "s3:bucket",
          "lambda:function",
          "logs:log-group"
        ]
      }
    },
    "Environment": {
      "tag_key": {
        "@@assign": "Environment"
      },
      "tag_value": {
        "@@assign": ["platform", "lab", "bootstrap"]
      }
    },
    "ManagedBy": {
      "tag_key": {
        "@@assign": "ManagedBy"
      },
      "tag_value": {
        "@@assign": ["terraform", "manual"]
      }
    },
    "OwnerEmail": {
      "tag_key": {
        "@@assign": "OwnerEmail"
      }
    },
    "AutoDelete": {
      "tag_key": {
        "@@assign": "AutoDelete"
      }
    }
  }
}
