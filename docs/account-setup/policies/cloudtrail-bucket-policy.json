{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck",
      "Effect": "Allow",
      "Principal": {"Service": "cloudtrail.amazonaws.com"},
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::aws-cloudtrail-org-174230265051-us-east-2",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-2:174230265051:trail/org-trail"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWriteMgmtAccount",
      "Effect": "Allow",
      "Principal": {"Service": "cloudtrail.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::aws-cloudtrail-org-174230265051-us-east-2/AWSLogs/174230265051/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-2:174230265051:trail/org-trail"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWriteOrgMembers",
      "Effect": "Allow",
      "Principal": {"Service": "cloudtrail.amazonaws.com"},
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::aws-cloudtrail-org-174230265051-us-east-2/AWSLogs/o-md68aqrkqu/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:us-east-2:174230265051:trail/org-trail"
        }
      }
    }
  ]
}
